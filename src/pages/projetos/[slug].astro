---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projetos = await getCollection('projetos');
  return projetos.map((projeto) => ({
    params: { slug: projeto.id },
    props: { projeto },
  }));
}

const { projeto } = Astro.props;
const { Content } = await render(projeto);
const dados = projeto.data;
---

<Base title={`${dados.titulo} · Lucas Daniel Santos`} description={dados.resumo}>
  <section class="section">
    <div class="shell">
      <p class="label">
        <a href="/projetos/" style="color: var(--muted); text-decoration: none">Projetos</a>
        <span style="color: var(--faint)">/</span>
        <span style="color: var(--faint)">{dados.papel}</span>
      </p>

      <h1 style="margin-top: var(--sp-3); max-width: 22ch">{dados.titulo}</h1>

      <p class="lede" style="margin-top: var(--sp-4)">{dados.resumo}</p>

      <div class="hero__actions">
        <a class="btn btn--primary" href={dados.repo}>Ver o código</a>
        <a class="btn" href={dados.release}>Baixar a release</a>
      </div>

      <div class="facts">
        <div class="facts__row">
          <p class="label">Período</p>
          <p class="facts__value">{dados.periodo}</p>
        </div>
        {
          dados.ficha.map((linha) => (
            <div class="facts__row">
              <p class="label">{linha.rotulo}</p>
              <p class="facts__value">{linha.valor}</p>
            </div>
          ))
        }
      </div>

      <div class="dossier__metrics" style="margin-block: var(--sp-6)">
        {
          dados.metricas.map((metrica) => (
            <div class="dossier__metric">
              <b>{metrica.valor}</b>
              <span>{metrica.rotulo}</span>
            </div>
          ))
        }
      </div>

      <div class="media" style="margin-bottom: var(--sp-3)">
        <img src={dados.imagem} alt={dados.imagemAlt} loading="eager" decoding="async" />
      </div>

      {
        dados.imagem2 && (
          <div class="media" style="margin-bottom: var(--sp-7)">
            <img src={dados.imagem2} alt={dados.imagem2Alt} loading="lazy" decoding="async" />
          </div>
        )
      }

      <div class="prose">
        <Content />
      </div>

      <div class="dossier__stack" style="margin-top: var(--sp-6)">
        {dados.stack.map((item) => <span class="tag">{item}</span>)}
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="shell">
      <div class="closing__inner">
        <div>
          <h2>Ver os outros projetos</h2>
          <p style="margin-top: var(--sp-2); color: var(--muted)">
            Dois aplicativos desktop e um pipeline em Docker, todos publicados com release.
          </p>
        </div>
        <a class="btn btn--primary" href="/projetos/">Voltar para projetos</a>
      </div>
    </div>
  </section>
</Base>
