---
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const siteUrl = 'https://lucasdaniel2201.github.io';
const canonical = new URL(Astro.url.pathname, siteUrl).href;

const nav = [
  { href: '/', label: 'Início' },
  { href: '/projetos/', label: 'Projetos' },
  { href: '/sobre/', label: 'Sobre' },
];

const caminhoAtual = Astro.url.pathname.replace(/\/+$/, '') || '/';

function estadoDoLink(href: string) {
  const destino = href.replace(/\/+$/, '') || '/';
  if (destino === '/') {
    return caminhoAtual === '/' ? 'page' : undefined;
  }
  return caminhoAtual.startsWith(destino) ? 'page' : undefined;
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b1c22" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Portfólio de Lucas Daniel Santos: ferramentas próprias para implantar, documentar e monitorar infraestrutura."
    />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>

    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="brand" href="/">
          <span class="brand__mark">~/</span>
          <span>Lucas Daniel Santos</span>
        </a>

        <nav class="nav" aria-label="Principal">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={estadoDoLink(item.href)}>
                {item.label}
              </a>
            ))
          }
        </nav>

        <details class="nav-toggle">
          <summary>Menu</summary>
          <div class="nav-toggle__panel">
            {
              nav.map((item) => (
                <a href={item.href} aria-current={estadoDoLink(item.href)}>
                  {item.label}
                </a>
              ))
            }
          </div>
        </details>
      </div>
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <Footer />
  </body>
</html>
